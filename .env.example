# Copie este archivo a .env.local y ajuste los valores. Ninguno es secreto:
# todos terminan en el HTML público, por eso llevan el prefijo NEXT_PUBLIC_.

# URL pública del sitio (sin barra final). Se usa en canonical, sitemap y Open Graph.
# Si se deja vacía: en Vercel se usa su dominio de producción; si no, GitHub Pages.
NEXT_PUBLIC_SITE_URL=https://tiza-coderz.github.io

# Solo si publica en un subdirectorio (repo que no se llama <org>.github.io). Ej.: /tiza-web
NEXT_PUBLIC_BASE_PATH=

# ID del formulario de Formspree (https://formspree.io). Vacío = el formulario usa WhatsApp/mailto.
# El valor de producción está en .env.production.
NEXT_PUBLIC_FORMSPREE_ID=xkjrvjzj
