{
  "name": "tiza-coderz-web",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@14 out",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "shots": "tsx scripts/preview-shots.ts",
    "img": "tsx scripts/optimize-image.ts",
    "capture": "tsx scripts/capture-demo.ts",
    "marketing": "tsx scripts/generate-marketing.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/serve-handler": "^6.1.4",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve-handler": "^6.1.8",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.30.3",
  "description": "Web corporativa de Tiza Coderz",
  "engines": {
    "node": "22.x"
  }
}
